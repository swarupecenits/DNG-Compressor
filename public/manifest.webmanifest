{
  "name": "DNG Squeeze — lossless ProRAW compressor",
  "short_name": "DNG Squeeze",
  "description": "Make Apple ProRAW DNG photos about a quarter smaller with lossless JPEG XL. Runs entirely on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0c0b0a",
  "theme_color": "#0c0b0a",
  "categories": [
    "photo",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/x-adobe-dng": [
          ".dng"
        ]
      }
    }
  ]
}
